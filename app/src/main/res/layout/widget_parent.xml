<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/widget_quiet" style="@style/WidgetTile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_tile_gray" android:text="☝&#10;톡톡" android:textColor="#6D6D72" />
        <TextView android:id="@+id/widget_ding" style="@style/WidgetTile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_tile_red" android:text="●&#10;띵동" android:textColor="#FF3B30" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/widget_voice" style="@style/WidgetTile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_tile_orange" android:text="●&#10;음성" android:textColor="#FF9500" />
        <TextView android:id="@+id/widget_open" style="@style/WidgetTile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_tile_blue" android:text="↗&#10;앱 열기" android:textColor="#4B76A3" />
    </LinearLayout>
</LinearLayout>
